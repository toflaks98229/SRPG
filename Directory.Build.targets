<Project>

  <!--
    유니티가 생성하는 csproj 는 자기 <NoWarn> 을 직접 적습니다(0169;USG0001).
    Directory.Build.props 는 csproj 본문보다 <b>먼저</b> 읽히므로 거기서 정한 NoWarn 은
    그 줄에 그대로 덮어써집니다. targets 는 본문보다 <b>나중에</b> 읽히므로 여기서 덧붙입니다.

    CS1591(공개 멤버에 문서 주석 없음)만 끕니다.
    Directory.Build.props 에 이유를 적어 두었습니다.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
